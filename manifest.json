{
  "manifest_version": 3,
  "name": "BNet",
  "short_name": "BNet",
  "version": "1.4.0",
  "description": "Mutes hateful and extremist speech on any website, on your device. Tap any muted phrase to see it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BNet",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "ui/settings.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "offscreen",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/defaults.js",
        "src/engine.js",
        "src/treatments.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
